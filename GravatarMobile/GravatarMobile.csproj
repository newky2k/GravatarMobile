<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net10.0;net11.0;net10.0-windows;net11.0-windows</TargetFrameworks>
		<LangVersion>Latest</LangVersion>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<Configurations>Debug;Release</Configurations>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>DSoft.snk</AssemblyOriginatorKeyFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/newky2k/GravatarMobile</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Description>.NET API for Gravatar with support for images and profiles. Targets .NET Standard 2.0, .NET 10 and .NET 11, with WPF helpers for Windows.</Description>
		<Authors>newky2k</Authors>
		<Copyright>Copyright © 2026 DSoft</Copyright>
		<PackageProjectUrl>https://github.com/newky2k/GravatarMobile</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageId>DSoft.Gravatar.Mobile</PackageId>
		<PackageTags>gravatar</PackageTags>
		<PackageReleaseNotes>Rewritten core for .NET Standard 2.0, .NET 10 and .NET 11. Native iOS, Android and MAUI views will follow.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>DSIcon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
		<None Include="../DSIcon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<PropertyGroup Condition=" '$(Configuration)'=='Debug' ">
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)'=='Release' ">
		<!-- sourcelink: Declare that the Repository URL can be published to NuSpec -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<!-- sourcelink: Embed source files that are not tracked by the source control manager to the PDB -->
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<!-- sourcelink: Include PDB in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>

	<ItemGroup Condition=" '$(Configuration)'=='Release' ">
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TF_BUILD)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- Platform neutral code. The iOS, Android, Mac and UWP sources (*.ios.cs, *.android.cs, *.mac.cs, *.uwp.cs) are not built until the native view packages are ported. -->
	<ItemGroup>
		<Compile Include="**\*.shared.cs" />
		<Compile Include="**\*.shared.*.cs" />
	</ItemGroup>

	<PropertyGroup Condition=" $(TargetFramework.Contains('-windows')) ">
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup Condition=" $(TargetFramework.Contains('-windows')) ">
		<Compile Include="**\*.netf.netcore.cs" />
	</ItemGroup>

</Project>
