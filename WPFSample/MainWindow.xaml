<Window x:Class="WPFSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gravatar Mobile sample" Height="480" Width="400">
    <StackPanel Margin="16">
        <TextBlock Text="Email address" Margin="0,0,0,4"/>
        <TextBox x:Name="edtEmail" Text="myemailaddress@example.com"/>
        <Button x:Name="btnLoad" Content="Load" Width="120" Margin="0,12,0,12" HorizontalAlignment="Left" Click="OnLoadClicked"/>
        <Image x:Name="imgGravatar" Width="160" Height="160" HorizontalAlignment="Left"/>
        <TextBlock x:Name="lblName" Margin="0,12,0,0" FontSize="16"/>
        <TextBlock x:Name="lblStatus" Margin="0,4,0,0" Foreground="Gray"/>
    </StackPanel>
</Window>
